    {
      "id": "c1a62061-de56-4739-b62b-157d626e0680",
      "name": "Prepare Error Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const data = item.json;\n  const dlq = data.dead_letter;\n  const text = [\n    '*V4 unexpected workflow failure*',\n    `Workflow: ${dlq.source_workflow_name} (${dlq.source_workflow_id})`,\n    `Execution: ${dlq.failed_execution_id}`,\n    `Node: ${dlq.failed_node}`,\n    `Stage: ${dlq.error_stage}`,\n    `Category: ${dlq.error_category}`,\n    `Inquiry: ${dlq.inquiry_id || 'not linked'}`,\n    `Correlation: ${dlq.correlation_id || 'not available'}`,\n    `Dead letter: ${dlq.dead_letter_id}`,\n    `Retry eligible: ${data.recovery.retry_eligible ? 'yes' : 'no'}`,\n    `Error: ${dlq.error_message}`,\n    dlq.failed_execution_url ? `Execution URL: ${dlq.failed_execution_url}` : null,\n  ].filter(Boolean).join('\\n');\n  return { json: { ...data, alert: { channel_id: 'CONFIGURE_SLACK_CHANNEL_ID', text, status: 'pending' } } };\n});"
      }
    },
