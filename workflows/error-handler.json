        480,
        0
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "CONFIGURE_DATA_TABLE",
          "mode": "list",
          "cachedResultName": "construction_inquiries_v4"
        },
        "returnAll": false,
        "limit": 1,
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "execution_id",
              "condition": "eq",
              "keyValue": "={{ $json.dead_letter.failed_execution_id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "81114f5d-8d96-4b3c-9539-98dd4a52a13c",
      "name": "Attach Inquiry Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const originals = $('Normalize Unexpected Error').all();\nreturn $input.all().map((item, index) => {\n  const original = originals[index]?.json;\n  if (!original) throw new Error(`Missing normalized error item ${index}`);\n  const row = item.json?.inquiry_id ? item.json : null;\n  return {\n    json: {\n      ...original,\n      inquiry_lookup: {\n        matched: Boolean(row),\n        row_id: row?.id ?? null,\n      },\n      failed_inquiry: row,\n      dead_letter: {\n        ...original.dead_letter,\n        correlation_id: row?.correlation_id ?? '',\n        inquiry_id: row?.inquiry_id ?? '',\n        source_event_id: row?.source_event_id ?? '',\n        original_payload_json: row?.payload_json ?? '{}',\n      },\n    },\n  };\n});"
      }
    },
    {
      "id": "29f6d6b6-1759-48b1-9b43-6802b3dee9db",
      "name": "Classify Unexpected Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const stageRules = [\n  { pattern: /receive|normalize|validate|identity|duplicate|store intake/i, stage: 'intake' },\n  { pattern: /groq|ai result|business rules/i, stage: 'ai' },\n  { pattern: /hubspot|contact|deal/i, stage: 'crm' },\n  { pattern: /gmail|slack|communication/i, stage: 'communication' },\n  { pattern: /follow-up|followup|wait/i, stage: 'followup' },\n  { pattern: /persist|data table/i, stage: 'storage' },\n];\n\nreturn $input.all().map((item) => {\n  const data = item.json;\n  const node = data.dead_letter.failed_node;\n  const message = data.dead_letter.error_message;\n  const stage = stageRules.find((rule) => rule.pattern.test(node))?.stage ?? 'unknown';\n  const combined = `${node} ${message}`;\n\n  let category = 'unexpected';\n  let retryEligible = false;\n  if (/credential|unauthorized|forbidden|authentication|401|403/i.test(combined)) category = 'authentication';\n  else if (/rate limit|too many requests|429/i.test(combined)) { category = 'rate_limit'; retryEligible = true; }\n  else if (/timeout|timed out|ECONN|connection|socket|network/i.test(combined)) { category = 'transient_network'; retryEligible = true; }\n  else if (stage === 'communication' && /gmail|slack|email|message/i.test(combined)) { category = 'provider_communication'; retryEligible = true; }\n  else if (/expression|undefined|null|not a function|referenced node|invalid parameter/i.test(combined)) category = 'workflow_logic';\n  else if (/validation|schema|invalid input|required/i.test(combined)) category = 'data_validation';\n\n  return {\n    json: {\n      ...data,\n      dead_letter: {\n        ...data.dead_letter,\n        error_stage: stage,\n        error_category: category,\n      },\n      recovery: {\n        retry_eligible: retryEligible,\n        recommended_action: retryEligible ? 'review_then_retry' : 'manual_investigation',\n      },\n    },\n  };\n});"
      }
    },
