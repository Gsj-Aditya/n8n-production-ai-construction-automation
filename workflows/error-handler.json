      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "jsCode": "const originals = $('Restore Dead Letter Context').all();\nreturn $input.all().map((item, index) => {\n  const original = originals[index]?.json;\n  if (!original) throw new Error(`Missing stored dead-letter context ${index}`);\n  return { json: { ...original, inquiry_link: {\n    attempted: original.inquiry_lookup.matched,\n    persisted: original.inquiry_lookup.matched && !item.json.error,\n    error: item.json.error?.message ?? null,\n  } } };\n});"
      }
    }
