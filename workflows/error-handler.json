{
  "name": "V4 - Construction Automation Error Handler",
  "description": "Portfolio template: AI-enriched construction inquiry intake with idempotency, Groq classification, deterministic rules, HubSpot Contact/Deal synchronization, retries, fallbacks, and persistent audit status.",
  "nodes": [
    {
      "id": "e34ac7d4-ec2e-4914-979e-a05c0d2023bb",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "03b93c85-c45b-44e3-9023-a8d2d6a1e969",
      "name": "Normalize Unexpected Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const envelope = item.json;\n  const execution = envelope.execution ?? {};\n  const workflow = envelope.workflow ?? {};\n  const executionId = execution.id !== undefined ? String(execution.id) : 'unknown';\n  const workflowId = workflow.id !== undefined ? String(workflow.id) : 'unknown';\n  const now = new Date().toISOString();\n\n  return {\n    json: {\n      dead_letter: {\n        dead_letter_id: `dlq_${workflowId}_${executionId}_${Date.now()}`,\n        created_at: now,\n        status: 'open',\n        source_workflow_id: workflowId,\n        source_workflow_name: workflow.name ?? 'Unknown workflow',\n        failed_execution_id: executionId,\n        failed_execution_url: execution.url ?? '',\n        retry_of: execution.retryOf !== undefined && execution.retryOf !== null ? String(execution.retryOf) : '',\n        execution_mode: execution.mode ?? 'unknown',\n        failed_node: execution.lastNodeExecuted ?? 'unknown',\n        error_message: execution.error?.message ?? 'Unknown execution error',\n        error_stack: execution.error?.stack ?? '',\n        error_stage: 'unclassified',\n        error_category: 'unclassified',\n        correlation_id: '',\n        inquiry_id: '',\n        source_event_id: '',\n        original_payload_json: '{}',\n        attempt_count: 0,\n        last_attempt_at: '',\n        resolved_at: '',\n        resolution_note: '',\n      },\n      error_envelope: envelope,\n    },\n  };\n});"
      }
    },
    {
      "id": "e7be8cb0-7c55-4f34-94b1-07ded25ed18a",
      "name": "Find Inquiry by Execution ID",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
