        "jsCode": "const originals = $('Classify Unexpected Error').all();\nreturn $input.all().map((item, index) => {\n  const original = originals[index]?.json;\n  if (!original) throw new Error(`Missing classified dead-letter context ${index}`);\n  return { json: { ...original, dead_letter: { ...original.dead_letter, stored: true, table_row_id: item.json.id ?? null } } };\n});"
