      "parameters": {
        "jsCode": "const originals = $('Prepare Error Alert').all();\nreturn $input.all().map((item, index) => {\n  const original = originals[index]?.json;\n  if (!original) throw new Error(`Missing error-alert context ${index}`);\n  const failed = Boolean(item.json.error) || item.json.ok === false;\n  return { json: { ...original, alert: { ...original.alert,\n    status: failed ? 'failed' : 'sent',\n    provider_message_id: failed ? null : String(item.json.ts ?? item.json.message?.ts ?? ''),\n    error: failed ? (item.json.error?.message ?? item.json.error ?? 'Slack alert failed') : null,\n  } } };\n});"
      }
